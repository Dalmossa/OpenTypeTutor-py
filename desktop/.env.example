# Example environment variables for OpenType Tutor Desktop
# Copy this file to .env and adjust values for your machine.

# API
API_BASE_URL=http://localhost:3000

# Token storage (use full path, e.g. /home/user/.config/opentype-tutor/tokens.json)
TOKEN_STORAGE_PATH=/home/<user>/.config/opentype-tutor/tokens.json

# Theme
THEME_MODE=dark
THEME_COLOR=blue

# Polling / batching (ms)
POLLING_INTERVAL_MS=500
KEYSTROKE_BATCH_SIZE=50
KEYSTROKE_FLUSH_INTERVAL_MS=1000

# HTTP timeout (seconds)
REQUEST_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
