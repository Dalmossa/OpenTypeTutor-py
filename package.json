{
  "name": "open-type-tutor",
  "version": "1.0.0",
  "description": "OpenType Tutor — Backend REST API for adaptive typing training",
  "type": "module",
  "main": "dist/main-nest.js",
  "scripts": {
    "dev": "tsx watch src/main-nest.ts",
    "dev:web": "npm --prefix web run dev",
    "dev:api": "PORT=3001 npm run dev",
    "build": "tsc",
    "start": "node dist/main-nest.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx src/infrastructure/database/migrate.ts",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/submit.bench.ts",
    "bench:cena-a": "tsx bench/cena-a.bench.ts",
    "bench:dashboard": "tsx bench/dashboard.bench.ts",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "lint:staged": "lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "typing",
    "tutor",
    "adaptive",
    "clean-architecture",
    "ddd"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "ui-ux-pro-max-cli": "^2.15.0",
    "uipro-cli": "^2.2.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "autocannon": "^8.0.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
